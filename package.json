{
  "name": "@alphabros/enterprise",
  "version": "1.0.1",
  "description": "Alpha Bros studio enterprise layer for better-auth: SSO (SAML/OIDC), SCIM (Users+Groups), orgs, audit log, security policy, admin portal",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipFast-Syndicate/enterprise.git"
  },
  "homepage": "https://github.com/ShipFast-Syndicate/enterprise#readme",
  "bugs": {
    "url": "https://github.com/ShipFast-Syndicate/enterprise/issues"
  },
  "author": "Alpha Bros (https://alphabros.eu)",
  "keywords": [
    "better-auth",
    "sso",
    "saml",
    "oidc",
    "scim",
    "enterprise",
    "organizations",
    "audit-log",
    "alphabros"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/portal/*"
  ],
  "files": [
    "dist",
    "sql",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "ab-enterprise": "./dist/cli/index.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./portal": {
      "types": "./dist/portal/index.d.ts",
      "import": "./dist/portal/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && rm -rf sql && cp -R src/schema/sql sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@better-auth/api-key": "^1.7.10",
    "@better-auth/core": "^1.7.10",
    "@better-auth/passkey": "^1.7.10",
    "@better-auth/scim": "^1.7.10",
    "@better-auth/sso": "^1.7.10",
    "@libsql/client": "^0.15.15 || ^0.17.3 || ^0.18.0",
    "better-auth": "^1.7.10",
    "better-call": "^1.4.2",
    "drizzle-orm": "^0.45.2",
    "lit": "^3",
    "samlify": "^2.13.1"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/api-key": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/scim": "1.7.12",
    "@better-auth/sso": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@libsql/client": "^0.18.0",
    "@peculiar/x509": "^2.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "jose": "^6.2.13",
    "lit": "^3.3.3",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "samlify": "2.13.1",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/vitest-plugin>zod": "4.6.7",
      "@peculiar/asn1-android": "^2.11.0",
      "@peculiar/asn1-asym-key": "^2.11.0",
      "@peculiar/asn1-cms": "^2.11.0",
      "@peculiar/asn1-csr": "^2.11.0",
      "@peculiar/asn1-ecc": "^2.11.0",
      "@peculiar/asn1-pfx": "^2.11.0",
      "@peculiar/asn1-pkcs8": "^2.11.0",
      "@peculiar/asn1-pkcs9": "^2.11.0",
      "@peculiar/asn1-rsa": "^2.11.0",
      "@peculiar/asn1-schema": "^2.11.0",
      "@peculiar/asn1-x509": "^2.11.0",
      "@peculiar/asn1-x509-attr": "^2.11.0",
      "@peculiar/asn1-x509-post-quantum": "^2.11.0",
      "esbuild@^0.27.0": "^0.28.1",
      "handlebars": "^4.7.10",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "undici@>=7.18.0 <7.30.1": "7.30.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
