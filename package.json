{
  "name": "@alphabros/enterprise",
  "version": "0.0.0-development",
  "description": "Alpha Bros studio enterprise layer for better-auth: SSO (SAML/OIDC), SCIM (Users+Groups), orgs, audit log, security policy, admin portal",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "sql"
  ],
  "bin": {
    "ab-enterprise": "./dist/cli/index.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./portal": {
      "types": "./dist/portal/index.d.ts",
      "import": "./dist/portal/index.js"
    }
  },
  "scripts": {
    "build": "tsup && rm -rf sql && cp -R src/schema/sql sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@better-auth/api-key": "1.6.33",
    "@better-auth/passkey": "1.6.33",
    "@better-auth/scim": "1.6.33",
    "@better-auth/sso": "1.6.33",
    "@libsql/client": "^0.15.15",
    "better-auth": "1.6.33",
    "drizzle-orm": "^0.45.2",
    "lit": "^3"
  },
  "devDependencies": {
    "@better-auth/api-key": "1.6.33",
    "@better-auth/core": "1.6.33",
    "@better-auth/passkey": "1.6.33",
    "@better-auth/scim": "1.6.33",
    "@better-auth/sso": "1.6.33",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@libsql/client": "^0.15.15",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^4.1.11",
    "better-auth": "1.6.33",
    "better-call": "1.4.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "jose": "^6.1.3",
    "lit": "^3.3.3",
    "prettier": "^3.9.6",
    "samlify": "2.13.1",
    "semantic-release": "^24.2.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "pnpm": {
    "overrides": {
      "esbuild@^0.27.0": "^0.28.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-j8v8-g9cx-5qf4"
      ]
    }
  }
}
